# Classroom Attention Monitor — Environment Variables
# Copy this file to `.env` and fill in your values.
# The app reads settings with the CLASSMON_ prefix.

# ── Hardware Mode ────────────────────────────────────────────────────────────
# Options: webcam | rtsp | mock
CLASSMON_VIDEO_SOURCE=webcam
CLASSMON_WEBCAM_DEVICE_INDEX=0
CLASSMON_WEBCAM_FPS=15
CLASSMON_WEBCAM_WIDTH=640
CLASSMON_WEBCAM_HEIGHT=480

# Only required when VIDEO_SOURCE=rtsp
CLASSMON_RTSP_URL=rtsp://user:pass@camera-ip/live

# Options: mic | mock
CLASSMON_AUDIO_SOURCE=mic
CLASSMON_AUDIO_SAMPLE_RATE=16000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (development, no setup needed):
CLASSMON_DATABASE_URL=sqlite+aiosqlite:///./classmon.db

# PostgreSQL+TimescaleDB (production):
# CLASSMON_DATABASE_URL=postgresql+asyncpg://classmon:yourpassword@localhost/classmon

# ── API ──────────────────────────────────────────────────────────────────────
CLASSMON_API_HOST=0.0.0.0
CLASSMON_API_PORT=8000
CLASSMON_DEBUG=false
CLASSMON_LOG_LEVEL=INFO
